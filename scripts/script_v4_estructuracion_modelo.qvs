///$tab Main
SET ThousandSep=',';
SET DecimalSep='.';
SET MoneyThousandSep=',';
SET MoneyDecimalSep='.';
SET MoneyFormat='$ ###0.00;-$ ###0.00';
SET TimeFormat='h:mm:ss TT';
SET DateFormat='M/D/YYYY';
SET TimestampFormat='M/D/YYYY h:mm:ss[.fff] TT';
SET FirstWeekDay=6;
SET BrokenWeeks=1;
SET ReferenceDay=0;
SET FirstMonthOfYear=1;
SET CollationLocale='en-US';
SET CreateSearchIndexOnReload=1;
SET MonthNames='Jan;Feb;Mar;Apr;May;Jun;Jul;Aug;Sep;Oct;Nov;Dec';
SET LongMonthNames='January;February;March;April;May;June;July;August;September;October;November;December';
SET DayNames='Mon;Tue;Wed;Thu;Fri;Sat;Sun';
SET LongDayNames='Monday;Tuesday;Wednesday;Thursday;Friday;Saturday;Sunday';
SET NumericalAbbreviation='3:k;6:M;9:G;12:T;15:P;18:E;21:Z;24:Y;-3:m;-6:μ;-9:n;-12:p;-15:f;-18:a;-21:z;-24:y';

//creating the variable to define the connection to the data catalog in Qlik Cloud
SET vFileLocation = lib://DataFiles/;

//creating the variable to define our database connection to MS SQL Server
SET vDBConn='ABC';

///$tab Mapping Tables
// Create a Divisions and Shippers Mapping as a part of the optimization from snow flake to star schema

//OPTIMIZACIÓN: Star Schema
// MAPPING Divisions → Customers

//Sin la instruccion LIB CONNECT el mapping no funciona
LIB CONNECT TO $(vDBConn);

Divisions_Map:

MAPPING LOAD DivisionID, 
	DivisionName;

SELECT DivisionID,
	DivisionName
FROM divisions;

//OPTIMIZACIÓN: Star Schema
// MAPPING Shippers → Orders

Shippers_Map:
MAPPING LOAD ShipperID, 
	CompanyName as ShippersName; //usamos este alias para evitar una referencia circular

SELECT ShipperID,
	CompanyName
FROM shippers;

// Load UnitCost from Products table.
 
//OPTIMIZACION: Cálculo del margen y del costo de los bienes vendidos en OrderDetails

//En ocasiones es necesario crear una carga de mapeo para importar un campo de otra tabla 
//con el fin de realizar cálculos en una tabla que no contiene dicho campo

//creamos una carga mapping que importe los valores de UnitCost de la tabla Products
UnitCost_Map:
Mapping Load
	ProductID,
    UnitCost; 
SELECT ProductID,
		UnitCost
FROM products;

//Posteriormente, se agrega una instrucción ApplyMap a la tabla OrderDetails

///$tab DB_Measures
//loading Orders and OrdeDetails tables from ABC database
LIB CONNECT TO $(vDBConn);

//OPTIMIZACIÓN: Star Schema
// MAPPING Shippers → Orders
Orders:
LOAD OrderID, 
// 	OrderID as OrderRecordCounter,
	1 as OrderRecordCounter, // agregamos contador 
	CustomerID,
    CustomerID as ActiveCustomerID,
	EmployeeID,
    // se crea esto para identificar quien de los empleados es vendedor con el flag en la tabla employees
    EmployeeID as SalesPersonID,
	//ShipperID, 
    ApplyMap('Shippers_Map',ShipperID,'Missing') as ShipperName,
	FreightWeight,
    // se crean categorias de peso de carga con IF()
    IF(FreightWeight<30, 'Light', 
    	if(FreightWeight >= 30 and FreightWeight < 70, 'Medium', 'Heavy'))
        AS FreightWeightCategory,
    // Se crean clases de peso de carga con CLASS() con intervalos de 10 y usamos replace para no tener nombres de intervalos largos
    '>=' & REPLACE(Class(FreightWeight, 10, 'FrWeight'),'<= FrWeight <','<') as FreightClass,
    Date(Floor(OrderDate)) AS OrderDate // Floor () elimina el elemento de tiempo de OrderDate
 where OrderDate < now(); // para que los datos sean hasta la fecha de carga actual 

SELECT OrderID,
	CustomerID,
	EmployeeID,
	ShipperID,
	FreightWeight,
	OrderDate
FROM orders;

//OPTIMIZACION: Cálculo del margen y del costo de los bienes vendidos en OrderDetails a través de mapping

//LIB CONNECT TO 'ABC'; - se elimina porque ya se conecto arriba

OrderDetails:

Load *,
	LineSalesAmount-CostOfGoodsSold as Margin,
	// Calcula el total de ventas de cada pedido (OrderID) 
	// y lo mantiene en cada una de sus líneas sin agruparlas.
	Window(SUM(LineSalesAmount), OrderID) as OrderSalesAmt;

LOAD OrderID, 
	LineNo, 
    // clave compuesta para union con la tabla Shipments
    Autonumber(OrderID &'|'& LineNo) as OrderLineKey ,
	ProductID, 
	UnitPrice,
    UnitPrice * Quantity * (1 - Discount) AS LineSalesAmount,
    ApplyMap('UnitCost_Map', ProductID, 0) * Quantity as CostOfGoodsSold,
	Quantity, 
	Discount
    // El objetivo de este paso es filtrar la tabla OrderDetails indirectamente usando la función Exists(campo_en_memoria, campo_origen)
where Exists(OrderID,OrderID) // Para cada fila que lee de la base de datos origen, Qlik comprueba si el OrderID entrante existe en la lista de OrderID cargados previamente.
    ;

SELECT OrderID,
	"LineNo",
	ProductID,
	UnitPrice,
	Quantity,
	Discount
FROM orderdetails;

// OPTIMIZACIÓN: Star Schema
// JOIN OrderHeader → Orders

// creamos esta tabla para agrupar OrderDetails
//OrderHeader:
Left Join (Orders)

Load
	OrderID,
    SUM(LineSalesAmount) AS OrderSalesAmount
Resident OrderDetails
Group by OrderID;



// OPTIMIZACIÓN: Star Schema
// JOIN Shipments → OrderDetails
// Ambas tablas pueden relacionarse mediante OrderLineKey, construida a partir de OrderID + LineNo.
// Se incorpora ShipmentDate a OrderDetails porque necesitamos la fecha del envío
// asociada a cada línea de pedido.
// Resultado: se elimina la tabla Shipments y se simplifica el modelo.

//Shipments:
Left Join(OrderDetails)

LOAD 
// Comentamos los sgtes campos para evitar asociaciones con otras tablas
// 	OrderID, 
// 	LineNo, 
// 	CustomerID, 
// 	EmployeeID, 
// 	ShipperID, 
	//ProductID, //campo no necesario porque obtiene valores de OrderDetails
    //se crea un campo composite key basado en OrderID y LineNo   
    //utilizando el símbolo de ampersand ( & ).
    //Usamos autonumber para evitar que la clave sea texto
    Autonumber(OrderID &'|'& LineNo) as OrderLineKey,
	Date(Floor(ShipmentDate)) as ShipmentDate; //where exists (OrderID);

SELECT OrderID,
	"LineNo",
	CustomerID,
	EmployeeID,
	ShipperID,
	ProductID,
	ShipmentDate
FROM shipments;









///$tab DB_Dimensions
//loading Customers and Divisions tables from ABC database
LIB CONNECT TO $(vDBConn);

//OPTIMIZACIÓN: Star Schema
// MAPPING Divisions → Customers
Customers:
LOAD CustomerID, 
	CompanyName, 
	ContactName, 
	City, 
	Country, 
	//DivisionID, 
    ApplyMap('Divisions_Map',DivisionID) as DivisionName,
	Address, 
	Fax, 
	Phone, 
	PostalCode, 
	StateProvince;

SELECT CustomerID,
	CompanyName,
	ContactName,
	City,
	Country,
	DivisionID,
	Address,
	Fax,
	Phone,
	PostalCode,
	StateProvince
FROM customers;

//OPTIMIZACIÓN: Star Schema
// MAPPING Divisions → Customers
//Se comenta Divisions para usarla en la seccion  Mapping tables

// Divisions:
// LOAD DivisionID, 
// 	DivisionName;

// SELECT DivisionID,
