///$tab File_Dimensions
//Employees table load
Employees:
LOAD
    EmpID as EmployeeID,
    //"First Name" as FirstName,
    //"Last Name" as LastName,
    "First Name" &' '& "Last Name" AS FullName,
    DateOfBirth,
    StartDate,
    EndDate,
    OfficeID,
    JobTitle,
    FileName() as OrigFileSource,
    // flag que funciona asi: Busca el campo 'EmpID' en la tabla 'Employees' 
    //y lo compara con el campo 'SalesPersonID' en la tabla 'Orders'
    IF(Exists(SalesPersonID, EmpID),1,0) as SalesPersonFlag
FROM [$(vFileLocation)ABC_employees.xlsx]
(ooxml, embedded labels, table is Employees);

//1. Agregamos EmployeesNew tabla de nuevos empleados para aplicar concatenación automática con employees
//2. Al agregar un campo distinto (EmploymentType) ya no es concatenación atuomática, sino forzada
	//y para ello comentamos EmployeesNew y agregamos la función Concatenate()

//EmployeesNew:
Concatenate(Employees)
LOAD
    EmpID as EmployeeID,
    //"First Name",
    //"Last Name",
    "First Name" &' '& "Last Name" AS FullName,
    DateOfBirth,
    StartDate,
    EndDate,
    OfficeID,
    JobTitle,
    FileName() as OrigFileSource,
    EmploymentType,
    IF(Exists(SalesPersonID, EmpID),1,0) as SalesPersonFlag
FROM [lib://DataFiles/ABC_employees_new.xlsx]
(ooxml, embedded labels, table is Employees);



