// FROM divisions;

// Loading the Products table.

Products:
LOAD CategoryID, 
	ProductID, 
	ProductName, 
	QuantityPerUnit, 
	SupplierID, 
	ItemCost, 
	ItemPrice, 
	UnitsInStock, 
	UnitsOnOrder, 
	UnitCost, 
	UnitPrice as CataloguePrice; //usamos este alias para evitar una synthetic key 

SELECT CategoryID,
	ProductID,
	ProductName,
	QuantityPerUnit,
	SupplierID,
	ItemCost,
	ItemPrice,
	UnitsInStock,
	UnitsOnOrder,
	UnitCost,
	UnitPrice
FROM products;


//OPTIMIZACIÓN: Star Schema
// JOIN Categories → Products
// Products contiene CategoryID, que permite relacionarla con Categories.
// Se incorpora la información de Categories en Products porque ambas
// representan atributos de la misma dimensión de producto.
// Resultado: se elimina una tabla y se simplifica el modelo.

// Loading the Categories table. 
//Categories: 

Outer Join(Products)
LOAD CategoryID, 
	CategoryName, 
	Description;

SELECT CategoryID,
	CategoryName,
	Description
FROM categories;

