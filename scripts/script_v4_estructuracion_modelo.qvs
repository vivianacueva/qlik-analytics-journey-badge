Left Join(Employees)

LOAD
    EmpID AS EmployeeID,
    ReportsTo AS ManagerID
FROM [$(vFileLocation)ABC_org_structure.fix]
(txt, codepage is 28591, embedded labels, delimiter is spaces, msq);

// Creacion de una direccion de email para cada empleado, carga de un script 

left join(Employees) $(Must_Include=[$(vFileLocation)ABC_GenEmpEmailAddresses.qvs]);


// Loading the Suppliers  and SupplierBanc table

//usamos qualify para evitar synthetic keys y circular references 
Qualify *; 

// Unqualify garantiza que el nombre de la tabla no se agregue a los nombres de esos campos,
// ya que necesitan conectarse con otras tablas y establecer asociaciones
Unqualify SupplierID, SupplierBandID; 

//OPTIMIZACIÓN: Star Schema
// JOIN → Products

Suppliers: //no comentamos la tabla Suppliers por el qualify 
Left Join(Products)
LOAD
    Address,
    City,
    CompanyName,
    ContactName,
    Country,
    Fax,
    Phone,
    PostalCode,
    SupplierID,
    SupplierBandID
FROM [lib://DataFiles/ABC_suppliers.xml]
(XmlSimple, table is [root/suppliers]);

//Esto garantiza que todas las tablas que siguen en el script 
//no tengan nombres de tabla añadidos a sus nombres de campo correspondientes
Unqualify *;

//OPTIMIZACIÓN: Star Schema
// JOIN → Products

//SupplierBand:
Left Join(Products)
LOAD
    SupplierBandID,
    SupplierBand
FROM [lib://DataFiles/ABC_suppliers.xml]
(XmlSimple, table is [root/supplier_band]);

DROP Fields SupplierID, SupplierBandID;



///$tab Master Calendar
// Create the Master Calendar to fill in the date gaps in our Orders table

// 1.Calculamos fecha min y max: 1er método: busca en la tabla Orders el mmínimo y máximo valor
tFirstAndLastDates:
LOAD
    DATE(MIN(OrderDate)) AS minDate,
    DATE(MAX(OrderDate)) AS maxDate
RESIDENT Orders;

// //calculamos fecha min y max: 2do método (puede agilizar proceso): Trabaja con los valores distintos almacenados de OrderDate
// tFirstAndLastDates: 
// LOAD
// Num(Min(FieldValue('OrderDate', RecNo()))) AS minDate,
// Num(Max(FieldValue('OrderDate', RecNo()))) AS maxDate
// AUTOGENERATE FieldValueCount('OrderDate');//Devuelve cuántos valores distintos tiene OrderDate.

// 2. Almacenar primera, última fecha y fecha actual en variables
LET vMinDate = NUM(PEEK('minDate', 0, 'tFirstAndLastDates')); //Peek(nombrecampo, posicionfila, nombretabla)
LET vMaxDate = NUM(PEEK('maxDate', 0, 'tFirstAndLastDates'));
LET vToday = NUM(PEEK('maxDate', 0,'tFirstAndLastDates'));

// TRACE $(vMinDate); // en el mensaje de carga de codigo muestra el valor de la variable con TRACE()

// TRACE $(vMaxDate);

// 3. Generar tabla que genera fechas faltantes desde primer hasta ultimo pedido
TempCal:
LOAD
    // Generamos la fecha:
    // vMinDate = fecha inicial
    // IterNo() = número de iteración (1, 2, 3, ...)
    // -1 = permite que la primera fecha sea exactamente vMinDate
    DATE($(vMinDate) + IterNo() - 1) AS TempDate

// Utilizamos tFirstAndLastDates como tabla de origen.
// Esta tabla contiene las fechas mínima y máxima.
RESIDENT tFirstAndLastDates

// Repetimos el LOAD mientras la fecha generada
// sea menor o igual que la fecha máxima.
WHILE $(vMinDate) + IterNo() - 1 <= $(vMaxDate);

//Agregamos esto como paso adicional si es que el año fiscal no inicia en enero o si en la empresa se manejan
//otros periodos 

//Definimos el mes de inicio del año fiscal 
SET vFiscalYearStartMonth = 10;

// 4. Creamos el calendario maestro a partir de la tabla temporal TempCal.
MasterCalendar:

//Agregamos esto como paso adicional si es que el año fiscal no inicia en enero o si en la empresa se manejan
//otros periodos 
LOAD
    *,
    // Fiscal Calendar Quarter
    Dual('Q' & Ceil(FiscalMonth/3), Ceil(FiscalMonth/3)) as FiscalQuarter,  
    // Fiscal Calendar Month Name
    Dual(Text(Date(MonthEnd(OrderDate), 'MMM')), FiscalMonth) as FiscalMonthName; 

LOAD

    // Campo clave que conecta el calendario con la tabla Orders.
    // Debe tener el mismo nombre y valor que el campo de fecha de Orders.
    TempDate AS OrderDate, // Model links here to Orders

    // Extraemos diferentes componentes de la fecha
    // para facilitar el análisis temporal.
    Week(TempDate) AS Week,
    Year(TempDate) AS Year,
    Month(TempDate) AS Month,
    Day(TempDate) AS Day,
    WeekDay(TempDate) AS WeekDay,

    // Creamos el trimestre (Q1, Q2, Q3, Q4).
    // Dual() permite tener un valor de texto para mostrar
    // y un valor numérico para ordenar correctamente.
    Dual(
        'Q' & Ceil(Month(TempDate) / 3),
        Ceil(Month(TempDate) / 3)
    ) AS Quarter,

    // Creamos un campo que combina mes y año.
    // Ejemplo: Jan-2025, Feb-2025, Mar-2025...
    Date(MonthStart(TempDate), 'MMM-YYYY') AS MonthYear,

    // Creamos una combinación Semana-Año.
    // Se realizan ajustes para tratar correctamente las semanas
    // que pertenecen a un año diferente al año de la fecha.
    Week(TempDate) & '-' &

        // Si la semana es la 1 pero la fecha está en diciembre,
        // la semana pertenece al siguiente año.
        If(
            Week(TempDate) = 1 AND Month(TempDate) = 12,
            Year(TempDate) + 1,

            // Si la semana es 52 o 53 pero la fecha está en enero,
            // la semana pertenece al año anterior.
            If(
                Match(Week(TempDate), 52, 53) AND Month(TempDate) = 1,
                Year(TempDate) - 1,

                // En el resto de casos utilizamos el año de la fecha.
                Year(TempDate)
            )
        )
        AS WeekYear,

    // Flag para identificar si la fecha pertenece al año actual
    // hasta la fecha de hoy (Current Year To Date).
    // * -1 convierte TRUE (1) en -1 y FALSE (0) en 0.
    InYearToDate(TempDate, $(vToday), 0) * -1 AS CYTDFlag,

    // Flag para identificar si la fecha pertenece al mismo período
    // del año anterior (Last Year To Date).
    InYearToDate(TempDate, $(vToday), -1) * -1 AS LYTDFlag,

// Flag que indica si la fecha pertenece al período YTD (Year-To-Date),
// es decir, desde el inicio del año hasta el mismo día del año actual.
// Devuelve 1 si está dentro del YTD y 0 si no.
If(
    DayNumberOfYear(TempDate) <= DayNumberOfYear($(vToday)),
    1,
    0
) AS IsInYTD,

// Flag que indica si la fecha pertenece al período QTD (Quarter-To-Date),
// es decir, desde el inicio del trimestre hasta el mismo día del trimestre actual.
// Devuelve 1 si está dentro del QTD y 0 si no.
If(
    DayNumberOfQuarter(TempDate) <= DayNumberOfQuarter($(vToday)),
    1,
    0
) AS IsInQTD,

// Flag que indica si la fecha pertenece al período MTD (Month-To-Date),
// es decir, desde el primer día del mes hasta el día actual.
// Devuelve 1 si está dentro del MTD y 0 si no.
If(
    Day(TempDate) <= Day($(vToday)),
    1,
    0
) AS IsInMTD,

// Flag que identifica el mes actual.
// Devuelve 1 si TempDate pertenece al mismo mes que la fecha actual y 0 si no.
If(
    Month(TempDate) = Month($(vToday)),
    1,
    0
) AS IsCurrentMonth,

// Flag que identifica el mes anterior al mes actual.
// AddMonths(TempDate, 1) suma un mes a TempDate;
// si el mes resultante coincide con el mes actual, significa que TempDate
// pertenece al mes anterior.
// Devuelve 1 si es el mes anterior y 0 si no.
If(
    Month(AddMonths(TempDate, 1)) = Month($(vToday)),
    1,
    0
) AS IsLastMonth,


//Agregamos esto como paso adicional si es que el año fiscal no inicia en enero o si en la empresa se manejan
//otros periodos 

// Fiscal Calendar Month
Mod(Month(TempDate) - $(vFiscalYearStartMonth), 12) + 1 as FiscalMonth,  

// Fiscal Calendar Year 
YearName(TempDate, 0, $(vFiscalYearStartMonth))as FiscalYear			

// Cargamos los datos desde la tabla temporal que contiene
// todas las fechas entre vMinDate y vMaxDate.
RESIDENT TempCal;


// Eliminamos las tablas temporales que ya no necesitamos,
// para evitar mantener datos innecesarios en el modelo.
DROP TABLE tFirstAndLastDates;
DROP TABLE TempCal;





